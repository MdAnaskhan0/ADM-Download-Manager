{
  "name": "anas-download-manager",
  "version": "1.0.0",
  "description": "A Linux desktop download manager powered by Electron, aria2 and yt-dlp",
  "main": "electron/main.cjs",
  "author": "ADM",
  "license": "MIT",
  "scripts": {
  "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
  "build": "vite build",
  "dist:linux": "npm run build && electron-builder --linux"
},
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.anas.downloadmanager",
    "productName": "Anas Download Manager",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "linux": {
      "category": "Network",
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png"
    }
  }
}
