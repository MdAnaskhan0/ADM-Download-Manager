{
  "manifest_version": 3,
  "name": "ADM - Send to Anas Download Manager",
  "version": "1.0.0",
  "description": "Send the current page URL to Anas Download Manager.",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:43821/*"],
  "action": {
    "default_title": "Send to ADM",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html"
}
